# ---- Telegram -------------------------------------------------------------
# Token from @BotFather (never commit the real .env!)
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Comma-separated Telegram user IDs allowed to run /stats, /broadcast, /update_ytdlp
ADMIN_IDS=123456789,987654321

# Force-subscribe (optional). Leave empty to disable.
# The bot must be an ADMIN of this channel to check membership.
FORCE_SUB_CHANNEL=
# Invite link shown to users (needed for private channels; optional for @public ones)
FORCE_SUB_CHANNEL_URL=

# ---- Local Bot API server (optional, lifts the 50 MB upload cap to 2 GB) -----
USE_LOCAL_BOT_API=false
LOCAL_BOT_API_URL=http://telegram-bot-api:8081
# Only needed by the telegram-bot-api container (docker-compose --profile local-api)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ---- Storage --------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
DOWNLOAD_DIR=./downloads
TEMP_FILE_TTL_MINUTES=60
CLEANUP_INTERVAL_MINUTES=30

# ---- yt-dlp ---------------------------------------------------------------
# Netscape-format cookies.txt (see README) for Instagram / age-restricted YouTube
COOKIES_FILE=
# e.g. socks5://127.0.0.1:1080 or http://user:pass@host:port
PROXY=
# YouTube player clients to try, comma separated (leave empty for yt-dlp defaults)
YT_PLAYER_CLIENTS=
DOWNLOAD_TIMEOUT_SECONDS=900
MAX_DURATION_MINUTES=180
AUDIO_BITRATE_KBPS=192
# Set to true to `pip install -U yt-dlp` every time the container starts
AUTO_UPDATE_YTDLP=true

# ---- Limits ---------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=5
MAX_CONCURRENT_DOWNLOADS=3

# ---- Misc -----------------------------------------------------------------
LOG_LEVEL=INFO
DEFAULT_LANGUAGE=uz
